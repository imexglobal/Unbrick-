# Copy to backend/.dev.vars for `npx wrangler dev`. Never commit .dev.vars.
ANTHROPIC_API_KEY=replace-with-your-anthropic-key
APP_TOKEN=replace-with-a-long-random-string
ANTHROPIC_MODEL=claude-haiku-5-5
MAX_TOKENS=1024
RATE_LIMIT_PER_MINUTE=12
DAILY_BUDGET_USD=0.55
TOTAL_BUDGET_USD=100
DEVICE_DAILY_LIMIT=30
PRICE_INPUT_PER_MTOK=0.10
PRICE_OUTPUT_PER_MTOK=0.50
PRICE_CACHE_WRITE_PER_MTOK=0.20
PRICE_CACHE_READ_PER_MTOK=0.01
RESERVE_TOKENS_PER_CHAR=2
